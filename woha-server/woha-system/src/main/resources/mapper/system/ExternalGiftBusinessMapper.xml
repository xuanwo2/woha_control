<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.woha.control.system.mapper.ExternalGiftBusinessMapper">
    <select id="selectValidProp" resultType="ExternalBusinessProp">select id, prop_type, prop_name from prop where id=#{id} and status=1 and prop_type in (1,2,4,6,7,11)</select>
    <select id="selectValidProps" resultType="ExternalBusinessProp">select id, prop_type, prop_name from prop where id in <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach> and status=1 and prop_type in (1,2,4,6,7,11)</select>
    <select id="selectPropsByIds" resultType="ExternalBusinessProp">select id, prop_type, prop_name from prop where id in <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></select>
    <update id="increaseGold">update user_purse set gold_num=gold_num+#{amount} where uid=#{uid}</update>
    <select id="selectGoldBalance" resultType="long">select gold_num from user_purse where uid=#{uid}</select>
    <insert id="insertGoldLog">insert into user_purse_log(uid,operator_type,amount,amount_type,balance,update_balance,order_id,order_type,create_time,remark,region_id) values(#{uid},1,#{amount},1,#{balance},1,#{orderId},2,now(),#{remark},#{regionId})</insert>
    <insert id="insertGoldBill">insert into bill_gold(uid,create_time,type,gold_num,country,order_id,bill_type,remark,region_id) select #{uid},now(),1,#{amount},country,#{orderId},2,#{remark},#{regionId} from `user` where uid=#{uid}</insert>
    <insert id="insertSysGoldRecord">insert into sys_gold_record(uid,gold_num,type,create_time,admin_id,reason,order_id,region_id) values(#{uid},#{amount},2,now(),#{adminId},#{reason},#{orderId},#{regionId})</insert>
    <insert id="insertPropGive">insert into prop_give(uid,prop_type,prop_id,prop_num,day_num,remark,create_time,expired_time,operator,status,region_id,prop_from) values(#{uid},#{prop.propType},#{prop.id},#{quantity},#{dayNum},#{remark},now(),date_add(now(),interval #{dayNum} day),'外管礼包',0,#{regionId},2)</insert>
    <insert id="insertVipCard">insert into bd_vip_gift_card(request_no,bd_leader_id,receiver_uid,noble_level,day_num,status,region_id,create_time) values(#{requestNo},#{issuerId},#{receiverUid},#{vipLevel},#{dayNum},0,#{regionId},now())</insert>
</mapper>
